'************************************************************
' SFS Single-Sensor CRBasic Program - Raw Heat Trace
' ICT International Pty. Ltd.
' Author: Rahinul Hoque
' Date: 30/07/2026
'****************************************
' Supports SFS Firmware v0-4-5 and above
'****************************************
'
' Description:
' This program operates one ICT International SFS (Sap Flow Sensor)
' probe on a CR1000X datalogger. The SFS is connected to a dedicated
' SDI-12 bus (C1) to ensure reliable communication during high-volume
' data transfers.
'
' The SFS uses the "HA!" command, which returns 600 values per
' measurement (150 seconds of high-resolution temperature data).
' Because this is a large data stream, a dedicated SDI-12 line
' prevents timing overlap and communication errors during heat-pulse
' acquisition.
'
' Measurement Cycle:
'   - One full heat-pulse measurement is performed every
'     10 minutes (600 seconds).
'   - The sensor collects 150 seconds of temperature data from
'     inner and outer thermistors.
'
' Program Features:
'   - Dedicated SDI-12 communication on port C1
'   - Raw-data table for the single SFS
'
' This program is designed for robust, field-ready SFS monitoring
' on the CR1000X platform.
'************************************************************


Const ValuesPerSensor = 600
Const RowsPerSensor   = 150

Public RawData(ValuesPerSensor)


'==========================
' USER CONFIGURATION
'==========================
Public Addr As String * 2 = "6"     ' SDI-12 address of SFS on C1

'==========================
' WORKING VARIABLES
'==========================
Public Downstream_Out, Downstream_In, Upstream_Out, Upstream_In As Float
Public TimeSec As Float
Public SFS_Measuring As Boolean
Dim n As Long
Dim base As Long

'************************************************************
' RAW DATA TABLE
'************************************************************
DataTable (Thermistor_Data_Raw, True, -1)
  Sample (1, TimeSec, FP2)
  Sample (1, Downstream_Out, FP2)
  Sample (1, Downstream_In,  FP2)
  Sample (1, Upstream_Out, FP2)
  Sample (1, Upstream_In,  FP2)
EndTable
'************************************************************
BeginProg

  '*Note: Change the following scan interval to the desired value; by default it is set to 10 minutes
  Scan(10, Min, 1, 0) 'Scanning every 10 minutes for data'
      '--------------------------------------------------------
      ' 1. TRIGGER HA! ON PORT C1
      '--------------------------------------------------------
      SFS_Measuring = True
      SDI12Recorder (RawData(1), C1, Addr, "HA!", 1, 0)

      Delay(1, 2, 2)
      
      '--------------------------------------------------------
      ' 2. PROCESS RAW DATA
      '--------------------------------------------------------
      For n = 1 To RowsPerSensor

        base = (n - 1) * 4

        Downstream_Out = RawData(base + 1)
        Downstream_In  = RawData(base + 2)
        Upstream_Out = RawData(base + 3)
        Upstream_In  = RawData(base + 4)

        TimeSec = n - 1
        
        CallTable Thermistor_Data_Raw

      Next n
      
    SFS_Measuring = False

  NextScan

EndProg

