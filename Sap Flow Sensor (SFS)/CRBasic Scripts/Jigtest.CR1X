'SFS Single Sensor Jig Test Program'
'Created by ICT International Pty. Ltd.'
'Author: Rahinul Hoque'
'Date: 09/03/2026'


'=============================================================================
'Description of Test'
'=============================================================================
'The following script is for 1 SFS running on the SDI-12 port/bus - C1
  '1. Make sure the address of the sensor is "0"
  '2. Add a multimeter that reads current in series with the supply power
  '3. Wiring Guide:
      ' 12V (CR1000x) ---> Multimeter (RED Probe - A)
      ' Multimeter (Black Probe - COM) ---> PWR (SFS)
      ' Data (SFS) ---> C1 (CR1000x)
      ' GND (SFS) ---> G (CR1000x)
'==============================================================================




'===========================================================
' VARIABLES
'===========================================================

Public Water_Test As Boolean
Public Thermistor_Position_Test As Boolean
Public Heater_Test As Boolean
Public Supercap_Test As Boolean
Public SensorIDRaw As String * 200
Public SDIResult As String * 200
Public Supercap_State As String * 200
Public HeaterRaw As String * 200
Public TestType As String * 40
Public HeaterDiagnostic As String * 40
Public Supercap_Voltage As Float
Public Downstream_TOP_Outer_Thermistor_Temp As Float
Public Downstream_TOP_Inner_Thermistor_Temp As Float
Public Upstream_BOTTOM_Outer_Thermistor_Temp As Float
Public Upstream_BOTTOM_Inner_Thermistor_Temp As Float
Public Diff As Float
Public Pass As Boolean
Public Fail As Boolean
Public Clear_Button As Boolean

Dim valueStr As String * 25
Dim signPos As Long
Dim signPos2 As Long
Dim signPos3 As Long
Dim j As Long

'===========================================================
' DATA TABLE
'===========================================================

DataTable(JigTests, True, -1)
  Sample(1, SensorIDRaw, String)
  Sample(1, TestType, String)
  Sample(1, Downstream_TOP_Outer_Thermistor_Temp, FP2)
  Sample(1, Downstream_TOP_Inner_Thermistor_Temp, FP2)
  Sample(1, Upstream_BOTTOM_Outer_Thermistor_Temp, FP2)
  Sample(1, Upstream_BOTTOM_Inner_Thermistor_Temp, FP2)
  Sample(1, Diff, FP2)
  Sample(1, Pass, Boolean)
  Sample(1, Fail, Boolean)
  Sample(1, HeaterRaw, String)
  Sample(1, Supercap_Voltage, Float)
  Sample(1, HeaterDiagnostic, String)
EndTable

'===========================================================
' PROGRAM START
'===========================================================

BeginProg

Scan(1, Sec, 1, 0)
 'Clear Button is used to clear previous logs
    If Clear_Button = True Then
        Pass = False
        Fail = False
        SDIResult = ""
        SensorIDRaw = ""
        HeaterDiagnostic = ""
        TestType = ""
        Supercap_State = ""
        HeaterRaw = ""
        Downstream_TOP_Outer_Thermistor_Temp = 0 : Downstream_TOP_Inner_Thermistor_Temp = 0 : Upstream_BOTTOM_Outer_Thermistor_Temp = 0 : Upstream_BOTTOM_Inner_Thermistor_Temp = 0
        Diff = 0
        Supercap_Voltage = 0
        Clear_Button = False
     End If

  '=========================================================
  ' WATER TEST
  '=========================================================
  If Water_Test Then
    Water_Test = False
    SDIResult = ""
    SensorIDRaw = ""
    HeaterDiagnostic = ""
    Pass = False
    Fail = False

  '-------------------------------------------------------
  ' Optional Identification Command
  '-------------------------------------------------------
    SDI12Recorder(SensorIDRaw, C1, 0, "I!", 1, 0, 0, 0)
    Delay(1, 1, 2)' 1 second wait to report

  '-------------------------------------------------------
  ' Start Raw Thermistor Measurement (C3!)
  '-------------------------------------------------------
    SDI12Recorder(SDIResult, C1, 0, "C3!", 1, 0, 0, 0)
    Delay(1, 10, 2) ' 10 seconds wait to finish measurement

  '-------------------------------------------------------
  '   Retrieve Raw Thermistor Data (D0!)
  '-------------------------------------------------------
    SDI12Recorder(SDIResult, C1, 0, "D0!", 1, 0, 0, 0)

    '-------------------------
    ' Parse Downstream_TOP_Outer_Thermistor_Temp
    '-------------------------
    valueStr = Mid(SDIResult, 2, 20)
    Downstream_TOP_Outer_Thermistor_Temp = valueStr

    '-------------------------
    ' Parse Downstream_TOP_Inner_Thermistor_Temp
    '-------------------------
    signPos = 0
    For j = 3 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos = j
        Exit For
      EndIf
    Next j

    If signPos > 0 Then
      valueStr = Mid(SDIResult, signPos, 20)
      Downstream_TOP_Inner_Thermistor_Temp = valueStr
    EndIf

    '-------------------------
    ' Parse Upstream_BOTTOM_Outer_Thermistor_Temp
    '-------------------------
    signPos2 = 0
    For j = signPos + 1 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos2 = j
        Exit For
      EndIf
    Next j

    If signPos2 > 0 Then
      valueStr = Mid(SDIResult, signPos2, 20)
      Upstream_BOTTOM_Outer_Thermistor_Temp = valueStr
    EndIf

    '-------------------------
    ' Parse Upstream_BOTTOM_Inner_Thermistor_Temp
    '-------------------------
    signPos3 = 0
    For j = signPos2 + 1 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos3 = j
        Exit For
      EndIf
    Next j

    If signPos3 > 0 Then
      valueStr = Mid(SDIResult, signPos3, 20)
      Upstream_BOTTOM_Inner_Thermistor_Temp = valueStr
    EndIf

    '-------------------------
    ' Compute Difference and Pass/Fail
    '-------------------------
    Dim MaxTemp As Float
    Dim MinTemp As Float

    MaxTemp = Downstream_TOP_Outer_Thermistor_Temp
    If Downstream_TOP_Inner_Thermistor_Temp > MaxTemp Then MaxTemp = Downstream_TOP_Inner_Thermistor_Temp
    If Upstream_BOTTOM_Outer_Thermistor_Temp > MaxTemp Then MaxTemp = Upstream_BOTTOM_Outer_Thermistor_Temp
    If Upstream_BOTTOM_Inner_Thermistor_Temp > MaxTemp Then MaxTemp = Upstream_BOTTOM_Inner_Thermistor_Temp

    MinTemp = Downstream_TOP_Outer_Thermistor_Temp
    If Downstream_TOP_Inner_Thermistor_Temp < MinTemp Then MinTemp = Downstream_TOP_Inner_Thermistor_Temp
    If Upstream_BOTTOM_Outer_Thermistor_Temp < MinTemp Then MinTemp = Upstream_BOTTOM_Outer_Thermistor_Temp
    If Upstream_BOTTOM_Inner_Thermistor_Temp < MinTemp Then MinTemp = Upstream_BOTTOM_Inner_Thermistor_Temp

    Diff = MaxTemp - MinTemp

    Pass = (Diff <= 0.4)
    Fail = Not Pass

    TestType = "Water Test"
    HeaterRaw = ""

    CallTable(JigTests)
  EndIf







  '=========================================================
  ' Thermistor Position Test
  '=========================================================
  If Thermistor_Position_Test Then
    Thermistor_Position_Test = False
    SDIResult = ""
    SensorIDRaw = ""
    HeaterDiagnostic = ""
    Pass = False
    Fail = False

  '-------------------------------------------------------
  ' Optional Identification Command
  '-------------------------------------------------------
    SDI12Recorder(SensorIDRaw, C1, 0, "I!", 1, 0, 0, 0)
    Delay(1, 1, 2)

  '-------------------------------------------------------
  ' Start Raw Thermistor Measurement (C3!)
  '-------------------------------------------------------
    SDI12Recorder(SDIResult, C1, 0, "C3!", 1, 0, 0, 0)
    Delay(1, 10, 2)

  '-------------------------------------------------------
  '   Retrieve Raw Thermistor Data (D0!)
  '-------------------------------------------------------
    SDI12Recorder(SDIResult, C1, 0, "D0!", 1, 0, 0, 0)

    '-------------------------
    ' Parse Downstream_TOP_Outer_Thermistor_Temp
    '-------------------------
    valueStr = Mid(SDIResult, 2, 20)
    Downstream_TOP_Outer_Thermistor_Temp = valueStr

    '-------------------------
    ' Parse Downstream_TOP_Inner_Thermistor_Temp
    '-------------------------
    signPos = 0
    For j = 3 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos = j
        Exit For
      EndIf
    Next j

    If signPos > 0 Then
      valueStr = Mid(SDIResult, signPos, 20)
      Downstream_TOP_Inner_Thermistor_Temp = valueStr
    EndIf

    '-------------------------
    ' Parse Upstream_BOTTOM_Outer_Thermistor_Temp
    '-------------------------
    signPos2 = 0
    For j = signPos + 1 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos2 = j
        Exit For
      EndIf
    Next j

    If signPos2 > 0 Then
      valueStr = Mid(SDIResult, signPos2, 20)
      Upstream_BOTTOM_Outer_Thermistor_Temp = valueStr
    EndIf

    '-------------------------
    ' Parse Upstream_BOTTOM_Inner_Thermistor_Temp
    '-------------------------
    signPos3 = 0
    For j = signPos2 + 1 To Len(SDIResult)
      If Mid(SDIResult, j, 1) = "+" OR Mid(SDIResult, j, 1) = "-" Then
        signPos3 = j
        Exit For
      EndIf
    Next j

    If signPos3 > 0 Then
      valueStr = Mid(SDIResult, signPos3, 20)
      Upstream_BOTTOM_Inner_Thermistor_Temp = valueStr
    EndIf

    Diff = 0
    Pass = False
    Fail = False
    TestType = "Thermistor Position Test"
    HeaterRaw = ""

    ''CallTable(JigTests)
  EndIf
  





'=========================================================
' HEATER TEST
'=========================================================

If Heater_Test Then
  Heater_Test = False
  SDIResult = ""
  SensorIDRaw = ""
  HeaterRaw = ""
  valueStr = ""

  '-------------------------------------------------------
  ' Optional Identification Command
  '-------------------------------------------------------
  SDI12Recorder(SensorIDRaw, C1, 0, "I!", 1, 0, 0, 0)
  Delay(1, 1, 2)

  '-------------------------------------------------------
  ' Start Heater Measurement (C2!)
  '-------------------------------------------------------
  SDI12Recorder(SDIResult, C1, 0, "C2!", 1, 0, 0, 0)
  Delay(1, 10, 2)
  Supercap_State = "Charging"

  '-------------------------------------------------------
  '   Retrieve Heater Data (D0!)
  '   Expected format: +01.000  or +02.000  or +03.000
  '-------------------------------------------------------
  SDI12Recorder(HeaterRaw, C1, 0, "D0!", 1, 0, 0, 0)

  '-------------------------------------------------------
  '   Extract Heater Code
  '   Character positions:
  '   a + 0 1 . 0 0 0
  '   1 2 3 4 5 6 7
  '   Heater code = character 4
  '-------------------------------------------------------
  valueStr = Mid(HeaterRaw, 4, 1)   ' returns "1", "2", or "3"

  '-------------------------------------------------------
  '  Interpret Heater Code
  '-------------------------------------------------------
  Select Case valueStr
    Case "1"
      HeaterDiagnostic = "Standard 18 ohm Probe Detected"
      Pass = True
    Case "2"
      HeaterDiagnostic = "Corn 8 ohm Probe Detected"
      Pass = True
    Case "3"
      HeaterDiagnostic = "Grape 13 ohm Probe Detected"
      Pass = True
    Case Else
      HeaterDiagnostic = "Probe Detection Failed"
      Fail = True
  EndSelect

  '-------------------------------------------------------
  '   Metadata for Logging
  '-------------------------------------------------------
  TestType = "Heater Test"
  

  '-------------------------------------------------------
  '   Log to Table
  '-------------------------------------------------------
  CallTable(JigTests)

EndIf







'==========================================================
'Supercap Test
'==========================================================

If Supercap_Test Then
    Supercap_Test = False
    Supercap_Voltage = 0
    Supercap_State = ""
    SDIResult = ""
    SensorIDRaw = ""
    HeaterDiagnostic = ""
    HeaterRaw = ""
    valueStr = ""
    Pass = False
    Fail = False
    
  '-------------------------------------------------------
  ' Optional Identification Command
  '-------------------------------------------------------
  SDI12Recorder(SensorIDRaw, C1, 0, "I!", 1, 0, 0, 0)
  Delay(1, 1, 2)
  
  '-------------------------------------------------------
  ' Start Supercacitor Measurement (C4!)
  '-------------------------------------------------------
  SDI12Recorder(SDIResult, C1, 0, "C4!", 1, 0, 0, 0)
        
            ' Example response: 1+04.60
            If Len(SDIResult) > 2 Then
                ' Extract everything after the address character
                valueStr = Mid(SDIResult, 2, 10)
                Supercap_Voltage = valueStr
            Else
                Supercap_Voltage = -9999
            EndIf
        
            ' Check if voltage ≥ 4.60 V
            If Supercap_Voltage >= 4.60 Then
                Pass = True
                Supercap_State = "Charged"
            Else
                Fail = True
                Supercap_State = "Charging/Check_Current_Draw=50mA"
            EndIf
        
            Delay(1, 1, 2) '250ms delay for each supercap voltage read'
            TestType = "Supercapacitor Test"
  CallTable(JigTests)
EndIf




NextScan

EndProg

